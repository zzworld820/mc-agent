{
  "name": "mc-agent",
  "version": "0.3.0",
  "private": true,
  "description": "基于 mineflayer 的 Minecraft NPC Agent：能聊天、能听指挥干活",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test-server": "bash scripts/paper-server.sh",
    "test-server:lite": "node scripts/test-server.cjs",
    "say": "node scripts/say.cjs",
    "survive": "node scripts/survive.mjs",
    "build:web": "node scripts/build-web.mjs",
    "prestart": "npm run build:web"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "minecraft",
    "mineflayer",
    "agent",
    "llm",
    "npc"
  ],
  "dependencies": {
    "buffer": "^6.0.3",
    "dotenv": "^18.0.10",
    "events": "^3.3.0",
    "express": "^4.22.3",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mongodb": "^6.22.0",
    "prismarine-viewer": "^1.33.0",
    "socket.io": "^4.8.4",
    "three": "^0.128.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "flying-squid": "^1.12.0"
  }
}
